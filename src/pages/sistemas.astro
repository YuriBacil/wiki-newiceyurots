---
import Layout from '../layouts/Layout.astro';
import MechanicCard from '../components/MechanicCard.astro';
import mechanics from '../data/mechanics.json';

const categories = [...new Set(mechanics.map(m => m.category))].sort();
---

<Layout title="Sistemas Custom - IceYuriots Wiki" description="Mecânicas exclusivas do IceYuriots OT explicadas em detalhes.">
  <div class="space-y-8">
    {/* Header */}
    <div class="text-center md:text-left animate-fade-in">
      <h2 class="font-rpg text-3xl text-tibia-gold font-bold tracking-wider mb-2">Sistemas Custom</h2>
      <p class="text-tibia-muted text-sm max-w-2xl">
        Mecânicas exclusivas do IceYuriots que tornam a experiência única. Clique em qualquer sistema para ler o guia completo, com fluxogramas e explicações detalhadas.
      </p>
    </div>

    {/* Filters */}
    <div class="flex flex-wrap gap-2 animate-fade-in" style="animation-delay: 0.1s;">
      <button
        type="button"
        class="filter-btn active px-3 py-1.5 rounded text-xs font-bold uppercase tracking-wider font-rpg transition-all border border-tibia-gold/40 bg-tibia-gold/15 text-tibia-gold"
        data-category="all"
      >
        Todos
      </button>
      {categories.map(category => (
        <button
          type="button"
          class="filter-btn px-3 py-1.5 rounded text-xs font-bold uppercase tracking-wider font-rpg transition-all border border-tibia-border-dark/40 bg-tibia-bg/60 text-tibia-muted hover:text-tibia-gold hover:border-tibia-gold/30"
          data-category={category}
        >
          {category}
        </button>
      ))}
    </div>

    {/* Search */}
    <div class="animate-fade-in" style="animation-delay: 0.15s;">
      <div class="relative max-w-md">
        <input
          type="text"
          id="mechanic-search"
          placeholder="Buscar sistema..."
          class="w-full bg-tibia-bg/60 border border-tibia-border-dark/40 rounded px-4 py-2.5 pl-10 text-sm text-tibia-text placeholder:text-tibia-muted focus:outline-none focus:border-tibia-gold/50 transition-colors"
        />
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-tibia-muted">🔍</span>
      </div>
    </div>

    {/* Grid */}
    <div id="mechanics-grid" class="grid grid-cols-1 gap-4">
      {mechanics.map((mechanic, index) => (
        <div class="mechanic-item" data-category={mechanic.category} data-title={mechanic.title.toLowerCase()}>
          <MechanicCard mechanic={mechanic} index={index} />
        </div>
      ))}
    </div>

    {/* Empty state */}
    <div id="empty-state" class="hidden text-center py-12">
      <div class="text-4xl mb-3">🔍</div>
      <h3 class="font-rpg text-lg text-tibia-gold font-bold mb-1">Nenhum sistema encontrado</h3>
      <p class="text-sm text-tibia-muted">Tente buscar com outro termo ou categoria.</p>
    </div>
  </div>
</Layout>

<script is:inline>
  (function() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.mechanic-item');
    const searchInput = document.getElementById('mechanic-search');
    const emptyState = document.getElementById('empty-state');
    const grid = document.getElementById('mechanics-grid');

    let activeCategory = 'all';
    let searchTerm = '';

    function update() {
      let visibleCount = 0;
      items.forEach(item => {
        const category = item.dataset.category;
        const title = item.dataset.title;
        const matchesCategory = activeCategory === 'all' || category === activeCategory;
        const matchesSearch = title.includes(searchTerm.toLowerCase());
        const visible = matchesCategory && matchesSearch;
        item.classList.toggle('hidden', !visible);
        if (visible) visibleCount++;
      });

      emptyState.classList.toggle('hidden', visibleCount > 0);
      grid.classList.toggle('hidden', visibleCount === 0);
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('active', 'bg-tibia-gold/15', 'text-tibia-gold', 'border-tibia-gold/40');
          b.classList.add('bg-tibia-bg/60', 'text-tibia-muted', 'border-tibia-border-dark/40');
        });
        btn.classList.add('active', 'bg-tibia-gold/15', 'text-tibia-gold', 'border-tibia-gold/40');
        btn.classList.remove('bg-tibia-bg/60', 'text-tibia-muted', 'border-tibia-border-dark/40');
        activeCategory = btn.dataset.category;
        update();
      });
    });

    searchInput.addEventListener('input', (e) => {
      searchTerm = e.target.value;
      update();
    });
  })();
</script>
