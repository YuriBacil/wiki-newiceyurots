    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    grid-template-rows: repeat(3, auto) !important;
    gap: 0.5rem !important;
    max-width: 520px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    animation: hubToTop 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes hubToTop {
    0% { opacity: 0.7; transform: translateY(16px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .tier-hub.hub-compact :global(.tier-hub-card) {
    padding: 0.375rem !important;
    border-radius: 0.375rem !important;
    min-height: auto !important;
  }

  .tier-hub.hub-compact :global(.tier-hub-card > div) {
    flex-direction: row !important;
    align-items: center !important;
    justify-content: flex-start !important;
    text-align: left !important;
    gap: 0.5rem !important;
    padding: 0 !important;
    min-height: auto !important;
  }

  .tier-hub.hub-compact :global(.tier-hub-card h3) {
    font-size: 0.75rem !important;
    margin-bottom: 0 !important;
    line-height: 1.2 !important;
  }

  .tier-hub.hub-compact :global(.tier-hub-card p),
  .tier-hub.hub-compact :global(.tier-hub-card > div > div:last-child) {
    display: none !important;
  }

  .tier-hub.hub-compact :global(.tier-hub-card > div > div:first-child) {
    width: 1.75rem !important;
    height: 1.75rem !important;
    font-size: 0.875rem !important;
    margin-bottom: 0 !important;
    flex-shrink: 0 !important;
  }

  .tier-hub.hub-compact :global(.tier-hub-card > div > div:first-child img) {
    width: 100% !important;
    height: 100% !important;
    padding: 0.125rem !important;
  }
</style>
