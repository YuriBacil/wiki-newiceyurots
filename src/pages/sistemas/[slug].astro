---
import { marked } from 'marked';
import Layout from '../../layouts/Layout.astro';
import MechanicSprite from '../../components/MechanicSprite.astro';
import MechanicFlow from '../../components/MechanicFlow.astro';
import FlowStep from '../../components/FlowStep.astro';
import InfoBox from '../../components/InfoBox.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import mechanics from '../../data/mechanics.json';

export function getStaticPaths() {
  return mechanics.map(m => ({ params: { slug: m.slug } }));
}

const { slug } = Astro.params;
const mechanic = mechanics.find(m => m.slug === slug);

if (!mechanic) {
  throw new Error(`Mecânica não encontrada: ${slug}`);
}

const contentHtml = marked.parse(mechanic.content);

const currentIndex = mechanics.findIndex(m => m.slug === slug);
const prevMechanic = currentIndex > 0 ? mechanics[currentIndex - 1] : null;
const nextMechanic = currentIndex < mechanics.length - 1 ? mechanics[currentIndex + 1] : null;

const flows: Record<string, { title: string; steps: { icon: string; title: string; description: string; variant?: 'default' | 'gold' | 'success' | 'danger' | 'info' }[] }> = {
  'auto-loot': {
    title: 'Como funciona o Auto Loot',
    steps: [
      { icon: '⚔️', title: 'Mata o monstro', description: 'Ao derrotar, o sistema dispara automaticamente.', variant: 'default' },
      { icon: '💰', title: 'Ouro para o banco', description: 'Gold, platinum e crystal coins vão direto para a conta bancária.', variant: 'gold' },
      { icon: '🎒', title: 'Itens no inventário', description: '4 slots (Free) ou 10 slots (VIP) configuráveis via !autoloot.', variant: 'success' },
      { icon: '👑', title: '!sellloot (VIP)', description: 'Venda expressa de todos os itens da lista com taxa de 3%.', variant: 'info' }
    ]
  },
  'awakening-system': {
    title: 'Ciclo do Despertar de Armas',
    steps: [
      { icon: '🔮', title: 'Despertar a arma', description: 'Custo de 10kk no Mestre de Artefatos.', variant: 'gold' },
      { icon: '⚔️', title: 'Ganhar Sintonia', description: '5% do XP dos monstros até 50.000 pontos.', variant: 'default' },
      { icon: '🔓', title: 'Desbloquear slots', description: '1.000 / 5.000 / 15.000 de sintonia para os 3 slots.', variant: 'info' },
      { icon: '🎲', title: 'Rolar traits', description: 'Sorteia 3 atributos e escolhe 1 por slot.', variant: 'success' },
      { icon: '⬆️', title: 'Aprimorar', description: 'Até nível 5, aumentando o valor do bônus.', variant: 'gold' },
      { icon: '🧹', title: 'Disenchant', description: 'Reseta todos os atributos mantendo a Sintonia acumulada.', variant: 'danger' }
    ]
  },
  'bless-iceyurots': {
    title: 'Proteção contra a perda na morte',
    steps: [
      { icon: '🛡️', title: '0 bênçãos', description: 'Sem proteção: perde 100% dos itens e penalidade total.', variant: 'danger' },
      { icon: '🕊️', title: 'Comprar bênçãos', description: 'NPC Blesser, Book of Blessings ou comando !bless por 1kk.', variant: 'info' },
      { icon: '✨', title: '5 bênçãos', description: 'Proteção total: 0% de perda de itens e redução máxima de XP.', variant: 'success' }
    ]
  },
  'boss-aegis': {
    title: 'Fases do combate contra o Aegis',
    steps: [
      { icon: '⚔️', title: 'Fase 1 (100% → 50%)', description: 'Dano normal + Raio de Desintegração (25% do HP máximo).', variant: 'default' },
      { icon: '🛡️', title: 'Fase 2 (Escudo + Cristais)', description: 'Aegis imune. Destrua os 3 Cristais sob a Tempestade Estática.', variant: 'info' },
      { icon: '🔥', title: 'Fase 3 (Enrage)', description: 'Modo Fúria com Chuva de Meteoros constante (800-1500 dano).', variant: 'danger' },
      { icon: '🏆', title: 'Recompensa', description: '1 carga da skill Aegis of Immortal (Reborn no Limbo).', variant: 'gold' }
    ]
  },
  'cassino-interativo': {
    title: 'Ciclo da roleta de apostas',
    steps: [
      { icon: '🪙', title: 'Obter token', description: 'Adquira Rollete Tokens em quests, NPCs, hunts ou bosses.', variant: 'default' },
      { icon: '🎰', title: 'Puxar alavanca', description: 'Consome 1 token para iniciar o giro na máquina.', variant: 'gold' },
      { icon: '🎡', title: 'Girar roleta', description: 'Animação de 15 a 25 passos até desacelerar no prêmio.', variant: 'info' },
      { icon: '🏆', title: 'Resultado', description: '65% derrota · 25% consolação · 9.5% item raro · 0.5% jackpot épico.', variant: 'success' }
    ]
  },
  'castle-24hrs': {
    title: 'Guerra de Domínio do Castelo',
    steps: [
      { icon: '💠', title: 'Sabotar pilares', description: 'Invasores enfraquecem as defesas do castelo no altar.', variant: 'danger' },
      { icon: '👑', title: 'Conquistar o trono', description: 'Permanecer 60s no trono com a guilda para assumir o domínio.', variant: 'gold' },
      { icon: '🛡️', title: 'Fortalecer defesas', description: 'Upgrades de pilares guardiões até nível 5.', variant: 'info' },
      { icon: '📦', title: 'Baú diário', description: 'Recompensas exclusivas a cada 20h para a guild dominante.', variant: 'success' },
      { icon: '⚡', title: 'Bônus de XP', description: '+20% de experiência por 1h ao ativar o buff da guilda.', variant: 'gold' }
    ]
  },
  'dodge-critical-system': {
    title: 'Dodge e Critical no combate',
    steps: [
      { icon: '🎯', title: 'Fontes de Poder', description: 'Tiers no personagem, armadura (dodge), arma (crítico) e comidas.', variant: 'default' },
      { icon: '🏃', title: 'Dodge (Entropia)', description: 'Anula o dano de monstros (máx 50% Knight / 40% demais).', variant: 'info' },
      { icon: '⚡', title: 'Critical Strike', description: 'Multiplica dano por x1.5 a x2.0 (máx 40% de chance).', variant: 'success' },
      { icon: '📊', title: 'Consultar Status', description: 'Comandos rápidos !dodge e !critical.', variant: 'gold' }
    ]
  },
  'exp-booster': {
    title: 'Como empilhar bônus de XP',
    steps: [
      { icon: '🧪', title: 'Poção de XP', description: 'Até +50% de XP por 1h de duração.', variant: 'default' },
      { icon: '🔔', title: 'Sino Dourado', description: '+20% de bônus global para todos os jogadores do servidor.', variant: 'info' },
      { icon: '🏰', title: 'Bênção da Facção', description: '+20% de XP para todos os membros da guilda.', variant: 'gold' },
      { icon: '📿', title: 'Amuleto + Comida', description: '+10% e +25% de XP adicional acumulável.', variant: 'success' },
      { icon: '⚡', title: 'Bônus Especiais', description: 'Arma Desperta e Castle 24h somam separadamente acima do teto.', variant: 'gold' }
    ]
  },
  'food-especial': {
    title: 'Sistema de buffs alimentares (3 Slots)',
    steps: [
      { icon: '🔴', title: 'Slot Vermelho', description: 'Sobrevivência: HP máximo, proteção física e life leech.', variant: 'danger' },
      { icon: '🟡', title: 'Slot Amarelo', description: 'Magia: Mana máxima, magic level e mana leech.', variant: 'gold' },
      { icon: '🟢', title: 'Slot Verde', description: 'Hunting: Bônus de XP, aumento de capacidade, sorte e crítico.', variant: 'success' },
      { icon: '🍽️', title: 'Banquete do Caçador', description: 'Preenche os 3 slots com os melhores buffs ao mesmo tempo.', variant: 'info' }
    ]
  },
  'mining-system': {
    title: 'Mineração Dinâmica & Upgrades',
    steps: [
      { icon: '⛏️', title: 'Usar Picareta', description: 'Normal Pickaxe (1.0x / 5% crit) ou Fire Pickaxe (1.5x / 10% crit).', variant: 'default' },
      { icon: '💠', title: 'Quebrar Cristais', description: 'Small Ice (Lvl 1), Fire (Lvl 5), Large Ice (Lvl 10) e Death (Lvl 15).', variant: 'info' },
      { icon: '💎', title: 'Coletar Minérios', description: '60% minérios · 10% emboscada de monstros · 30% vazio.', variant: 'success' },
      { icon: '⚡', title: 'Estamina & Nível', description: '1000 base, consome 10 por golpe e ganha XP de mineração.', variant: 'gold' },
      { icon: '📈', title: '6 Upgrades', description: 'Evolua Vigor, Dano, Crítico e Fartura com Ice Crystals e Ouro.', variant: 'gold' }
    ]
  },
  'new-promotion': {
    title: 'Evolução de Classe (3 Camadas)',
    steps: [
      { icon: '🎭', title: 'Classe Básica', description: 'Sorcerer, Druid, Paladin ou Knight.', variant: 'default' },
      { icon: '⬆️', title: 'Tier 2: Promovida', description: 'Nível 50.000 + 5kk no Mestre Vaelor.', variant: 'info' },
      { icon: '🔄', title: 'Requisito: 2 Resets', description: 'Conclua ao menos 2 rituais de ascensão para transcender.', variant: 'gold' },
      { icon: '⚔️', title: 'Tier 3: Sub-Classe', description: 'Escolha definitiva entre 2 sub-classes por 500kk no General Boros.', variant: 'success' }
    ]
  },
  'pedra-evolucao': {
    title: 'Evolução de Equipamento com Pedras',
    steps: [
      { icon: '💎', title: 'Obter pedras', description: 'Colete pedras de evolução em drops de monstros e bosses.', variant: 'default' },
      { icon: '⚙️', title: 'Usar no equipamento', description: 'Aplique em armas, escudos, armaduras, elmos, pernas e botas.', variant: 'info' },
      { icon: '📈', title: 'Carregar XP', description: 'A barra de experiência do equipamento é preenchida até o limite.', variant: 'gold' },
      { icon: '🔮', title: 'Mestre das Almas', description: 'Use 10 XP + 1kk para sortear atributos e aprimorar o item.', variant: 'success' }
    ]
  },
  'perk-system': {
    title: 'Progressão da Árvore de Perks',
    steps: [
      { icon: '🔄', title: 'Fazer Reset', description: 'Cada reset concluído concede +1 Soul Point permanente.', variant: 'default' },
      { icon: '💠', title: 'Acumular SP', description: 'Pontos de alma vinculados à progressão do seu personagem.', variant: 'info' },
      { icon: '🧠', title: 'Comando !perks', description: 'Abre a interface da árvore de talentos e especializações.', variant: 'gold' },
      { icon: '⬆️', title: 'Aprimorar', description: 'Invista SP em poder ofensivo, defesas, vida, mana e utilidades.', variant: 'success' }
    ]
  },
  'pet-system': {
    title: 'Como usar o Pet System',
    steps: [
      { icon: '🎁', title: 'Obter summon', description: 'Consiga o item do pet através de NPCs, quests ou bosses.', variant: 'default' },
      { icon: '🐾', title: 'Invocar pet', description: 'Use o item para invocar seu companheiro de combate ao lado.', variant: 'info' },
      { icon: '⚔️', title: 'Habilidades', description: 'Ataques elementares, cura periódica, buffs e controle de grupo.', variant: 'success' },
      { icon: '📈', title: 'Escalação de HP', description: 'A vida e poder do pet escalam proporcionalmente ao seu nível e resets.', variant: 'gold' }
    ]
  },
  'reset-system': {
    title: 'Ciclo do Ritual da Ascensão',
    steps: [
      { icon: '📊', title: 'Nível Requerido', description: '150.000 + 30.000 por cada reset já realizado.', variant: 'default' },
      { icon: '💰', title: 'Custo em Ouro', description: '50kk + 10kk por cada reset acumulado.', variant: 'gold' },
      { icon: '🔄', title: 'Executar Reset', description: 'Retorna ao nível 150 preservando 15% do HP/MP máximo.', variant: 'info' },
      { icon: '💎', title: 'Recompensas', description: '+1 Soul Point para Perks e avanço rumo ao Tier 3 de classe.', variant: 'success' }
    ]
  }
};

const flow = flows[mechanic.slug];
---

<Layout title={`${mechanic.title} - IceYuriots Wiki`} description={mechanic.summary}>
  {/* Reading progress bar */}
  <div class="fixed top-0 left-0 h-0.5 bg-tibia-gold z-[60] transition-all duration-150" id="reading-progress" style="width: 0%;"></div>

  <article class="max-w-4xl mx-auto animate-fade-in">
    {/* Breadcrumb */}
    <div class="flex items-center gap-2 text-xs text-tibia-muted mb-6">
      <a href="/" class="hover:text-tibia-gold transition-colors">Home</a>
      <span>/</span>
      <a href="/sistemas" class="hover:text-tibia-gold transition-colors">Sistemas</a>
      <span>/</span>
      <span class="text-tibia-gold">{mechanic.title}</span>
    </div>

    {/* Hero */}
    <div class="relative overflow-hidden rounded-xl rpg-border bg-tibia-panel/80 p-6 md:p-10 mb-8">
      <div class="absolute inset-0 bg-gradient-to-br from-tibia-gold/5 via-transparent to-transparent"></div>
      <div class="relative flex flex-col md:flex-row gap-6 items-center md:items-start text-center md:text-left">
        <div class="animate-float">
          <MechanicSprite id={mechanic.slug || mechanic.id} icon={mechanic.icon} size="xl" />
        </div>
        <div class="flex-1">
          <span class="inline-block text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded border border-tibia-gold/20 bg-tibia-gold/10 text-tibia-gold mb-3">
            {mechanic.category}
          </span>
          <h1 class="font-rpg text-2xl md:text-4xl text-tibia-gold font-bold tracking-wide mb-4">
            {mechanic.title}
          </h1>
          <p class="text-base text-tibia-text/90 leading-relaxed max-w-2xl">
            {mechanic.summary}
          </p>
        </div>
      </div>
    </div>

    {/* Visual Flow */}
    {flow && (
      <div class="mb-8 animate-slide-up" style="animation-delay: 0.1s;">
        <MechanicFlow title={flow.title}>
          {flow.steps.map((step, i) => (
            <>
              <FlowStep {...step} />
              {i < flow.steps.length - 1 && (
                <div class="hidden md:flex items-center justify-center text-tibia-gold/50 flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              )}
            </>
          ))}
        </MechanicFlow>
      </div>
    )}

    {/* Quick Info Box */}
    <InfoBox type="info">
      Este é um guia completo. Você pode usar o índice abaixo para navegar entre as seções. As informações são baseadas nos documentos oficiais do servidor.
    </InfoBox>

    <TableOfContents content={mechanic.content} />

    {/* Content */}
    <div class="markdown-content animate-slide-up" style="animation-delay: 0.2s;" set:html={contentHtml} />

    {/* Back to top */}
    <div class="flex justify-center my-8 animate-fade-in">
      <button
        type="button"
        onclick="window.scrollTo({ top: 0, behavior: 'smooth' });"
        class="group flex items-center gap-2 px-4 py-2 rounded-lg bg-tibia-bg/60 border border-tibia-border-dark/30 hover:border-tibia-gold/40 text-tibia-muted hover:text-tibia-gold transition-all"
      >
        <span class="transition-transform group-hover:-translate-y-0.5">↑</span>
        <span class="text-xs font-bold uppercase tracking-wider font-rpg">Voltar ao topo</span>
      </button>
    </div>

    {/* Navigation */}
    <div class="mt-12 pt-8 border-t border-tibia-border-dark/40 grid grid-cols-1 md:grid-cols-2 gap-4 animate-fade-in">
      {prevMechanic ? (
        <a
          href={`/sistemas/${prevMechanic.slug}`}
          class="group flex items-center gap-4 p-4 rounded-lg bg-tibia-bg/60 border border-tibia-border-dark/30 hover:border-tibia-gold/30 transition-all"
        >
          <span class="text-2xl">{prevMechanic.icon}</span>
          <div class="flex-1">
            <span class="text-[10px] text-tibia-muted uppercase tracking-wider">Anterior</span>
            <h4 class="font-rpg text-sm text-tibia-text font-bold group-hover:text-tibia-gold transition-colors">{prevMechanic.title}</h4>
          </div>
        </a>
      ) : <div />}
      {nextMechanic && (
        <a
          href={`/sistemas/${nextMechanic.slug}`}
          class="group flex items-center justify-end gap-4 p-4 rounded-lg bg-tibia-bg/60 border border-tibia-border-dark/30 hover:border-tibia-gold/30 transition-all text-right"
        >
          <div>
            <span class="text-[10px] text-tibia-muted uppercase tracking-wider">Próximo</span>
            <h4 class="font-rpg text-sm text-tibia-text font-bold group-hover:text-tibia-gold transition-colors">{nextMechanic.title}</h4>
          </div>
          <span class="text-2xl">{nextMechanic.icon}</span>
        </a>
      )}
    </div>
  </article>

  <script is:inline>
    (function() {
      const progressBar = document.getElementById('reading-progress');
      if (!progressBar) return;

      function updateProgress() {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        progressBar.style.width = progress + '%';
      }

      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    })();
  </script>
</Layout>
