    min-height: auto !important;
  }

  .tier-hub.hub-compact :global(.tier-hub-card h3) {
    font-size: 0.75rem !important;
    margin-bottom: 0 !important;
    line-height: 1.2 !important;
  }

  .tier-hub.hub-compact :global(.tier-hub-card p),
  .tier-hub.hub-compact :global(.tier-hub-card > div > div:last-child) {
    display: none !important;
  }

  .tier-hub.hub-compact :global(.tier-hub-card > div > div:first-child) {
    width: 1.75rem !important;
    height: 1.75rem !important;
    font-size: 0.875rem !important;
    margin-bottom: 0 !important;
