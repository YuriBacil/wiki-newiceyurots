---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const sections = [
  { href: '/bestiario', title: 'Bestiário', desc: 'Catálogo completo de criaturas, drops e XP.', icon: '🐉' },
  { href: '/itens', title: 'Equipamentos', desc: 'Armas, armaduras, escudos e itens do servidor.', icon: '⚔️' },
  { href: '/sistemas', title: 'Sistemas Custom', desc: 'Pets, mineração, upgrades e alimentos especiais.', icon: '✨' },
  { href: '/lore', title: 'Lore', desc: 'A história e crônicas do mundo de IceYuriots.', icon: '📜' },
];

// Carregar e ordenar atualizações
const allUpdates = await getCollection('updates');
allUpdates.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latestUpdates = allUpdates.slice(0, 3);

// Formatação curta da data
function formatShortDate(date: Date) {
  return date.toLocaleDateString('pt-BR', {
    day: '2-digit',
    month: 'short',
  }).replace('.', '');
}
---

<Layout title="IceYuriots OT - Wiki Oficial">
  <div class="flex flex-col lg:flex-row gap-8 items-start">
    <!-- Coluna principal -->
    <section class="lg:w-2/3 space-y-8">
      <div class="text-center lg:text-left">
        <h2 class="font-rpg text-3xl md:text-4xl text-tibia-gold font-bold tracking-wider mb-3">
          Bem-vindo, Guerreiro!
        </h2>
        <p class="text-tibia-muted text-sm md:text-base leading-relaxed max-w-2xl">
          Wiki oficial do IceYuriots OT. Aqui você encontra informações detalhadas sobre monstros, equipamentos,
          sistemas exclusivos e a história do servidor. Acesso livre para todos os jogadores.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {sections.map((s) => (
          <a
            href={s.href}
            class="group bg-tibia-panel/80 p-5 rounded rpg-border hover:border-tibia-gold/40 transition-all gold-glow"
          >
            <div class="flex items-start gap-4">
              <span class="text-3xl">{s.icon}</span>
              <div>
                <h3 class="font-rpg text-lg text-tibia-gold font-bold tracking-wide group-hover:text-white transition-colors">
                  {s.title}
                </h3>
                <p class="text-xs text-tibia-muted mt-1 leading-relaxed">{s.desc}</p>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="bg-tibia-panel/80 p-6 rounded rpg-border">
        <h3 class="font-rpg text-xl text-tibia-gold font-bold tracking-wider mb-4">Sobre o Servidor</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
          <div class="bg-tibia-bg/60 p-4 rounded border border-tibia-border-dark/25 text-center">
            <span class="block text-2xl font-rpg text-tibia-gold font-bold">8.60</span>
            <span class="text-xs text-tibia-muted uppercase tracking-wider">Versão Baiak</span>
          </div>
          <div class="bg-tibia-bg/60 p-4 rounded border border-tibia-border-dark/25 text-center">
            <span class="block text-2xl font-rpg text-tibia-gold font-bold">TFS 1.5</span>
            <span class="text-xs text-tibia-muted uppercase tracking-wider">Base do Servidor</span>
          </div>
          <div class="bg-tibia-bg/60 p-4 rounded border border-tibia-border-dark/25 text-center">
            <span class="block text-2xl font-rpg text-tibia-gold font-bold">Free</span>
            <span class="text-xs text-tibia-muted uppercase tracking-wider">Acesso Livre</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Patch notes -->
    <aside class="lg:w-1/3 bg-tibia-panel/75 p-6 rounded rpg-border w-full flex flex-col justify-between">
      <div>
        <div class="border-b border-tibia-border-dark/50 pb-3 mb-4 flex items-center justify-between">
          <h3 class="font-rpg text-lg text-tibia-gold font-bold tracking-wider">Patch Notes</h3>
          <span class="bg-tibia-border-dark/25 border border-tibia-border-dark text-[10px] text-tibia-gold px-2 py-0.5 rounded font-mono uppercase font-semibold">IceYuriots</span>
        </div>

        <div class="space-y-6">
          {latestUpdates.map((note, idx) => (
            <div class="relative pl-6 border-l-2 border-tibia-border-dark/40 last:border-l-0 pb-1">
              <div class={`absolute -left-[7px] top-1 w-3 h-3 rounded-full border-2 border-tibia-bg ${idx === 0 ? 'bg-tibia-gold' : 'bg-tibia-border-dark'}`}></div>
              <div class="flex items-center justify-between mb-1 gap-2">
                <h4 class="text-sm font-semibold text-tibia-gold font-rpg hover:text-white transition-colors">
                  <a href="/updates">{note.data.title}</a>
                </h4>
                <span class="text-[10px] text-tibia-muted font-mono whitespace-nowrap">{formatShortDate(note.data.date)}</span>
              </div>
              <p class="text-xs text-tibia-muted leading-relaxed line-clamp-2">{note.data.description}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-tibia-border-dark/30">
        <a
          href="/updates"
          class="block text-center w-full px-4 py-2 bg-tibia-bg text-tibia-gold hover:text-white border border-tibia-border-dark/60 hover:border-tibia-gold/40 rounded text-xs font-bold font-rpg tracking-wider transition-all"
        >
          Ver Todos os Updates
        </a>
      </div>
    </aside>
  </div>
</Layout>
