---
interface Props {
  tier: string;
}

const { tier } = Astro.props;

const labels: Record<string, string> = {
  tier1: 'T1',
  tier2: 'T2',
  tier3: 'T3',
  tier4: 'T4',
  bosses: 'BOSS',
  raros: 'RARO',
};

const colors: Record<string, string> = {
  tier1: 'text-emerald-400 border-emerald-500/30 bg-emerald-500/10',
  tier2: 'text-amber-400 border-amber-500/30 bg-amber-500/10',
  tier3: 'text-orange-400 border-orange-500/30 bg-orange-500/10',
  tier4: 'text-red-400 border-red-500/30 bg-red-500/10',
  bosses: 'text-purple-400 border-purple-500/30 bg-purple-500/10',
  raros: 'text-tibia-gold border-tibia-gold/30 bg-tibia-gold/10',
};

const label = labels[tier] || tier.toUpperCase();
const colorClass = colors[tier] || colors.tier1;
---

<span class={`text-[9px] font-mono font-semibold px-1.5 py-0.5 rounded border tracking-wider ${colorClass}`}>
  {label}
</span>
