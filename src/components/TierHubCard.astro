---
interface Props {
  tier: string;
  label: string;
  subtitle: string;
  count: number;
  color: string;
  locked?: boolean;
  icon: string;
  assetFolder?: 'bestiary-tiers' | 'item-tiers';
  countLabel?: string;
}

const { tier, label, subtitle, count, color, locked = false, icon, assetFolder, countLabel = 'criaturas' } = Astro.props;

const assetUrl = assetFolder ? `/assets/${assetFolder}/${tier}.png` : null;
---

<button
  type="button"
  data-tier={tier}
  data-locked={locked ? 'true' : 'false'}
  class={`tier-hub-card group relative w-full bg-tibia-panel/80 border border-tibia-border-dark/30 hover:border-tibia-gold/40 transition-all gold-glow rounded text-center overflow-hidden
    ${locked ? 'opacity-60 cursor-not-allowed' : 'cursor-pointer'}
  `}
>
  <div class={`absolute top-0 inset-x-0 h-20 opacity-10 transition-opacity duration-300 group-hover:opacity-20 ${color}`} style="mask-image: linear-gradient(to bottom, black, transparent); -webkit-mask-image: linear-gradient(to bottom, black, transparent);"></div>

  <div class="relative p-5 flex flex-col items-center justify-between h-full min-h-[180px]">
    <div class={`w-16 h-16 shrink-0 rounded border flex items-center justify-center text-4xl transition-all duration-300 overflow-hidden
      ${locked
        ? 'border-tibia-border-dark/40 bg-tibia-bg/60 grayscale'
        : 'border-tibia-gold/25 bg-tibia-bg/60 group-hover:border-tibia-gold/50 group-hover:scale-105'}
    `}>
      {locked ? (
        '🔒'
      ) : assetUrl ? (
        <>
          <img
            src={assetUrl}
            alt=""
            class="w-full h-full object-contain p-2"
            onerror={`this.style.display='none'; this.nextElementSibling.style.display='flex';`}
          />
          <span class="hidden w-full h-full items-center justify-center">{icon}</span>
        </>
      ) : (
        icon
      )}
    </div>

    <div class="mt-3">
      <h3 class={`font-rpg text-lg font-bold tracking-wide ${locked ? 'text-tibia-muted' : 'text-tibia-gold group-hover:text-white'} transition-colors`}>
        {label}
      </h3>
      <p class="text-[11px] text-tibia-muted mt-0.5">{subtitle}</p>
    </div>

    <div class="mt-auto pt-3">
      {locked ? (
        <span class="text-[9px] uppercase tracking-wider text-tibia-muted font-semibold">Em breve</span>
      ) : (
        <span class="inline-flex items-baseline gap-1">
          <span class="font-rpg text-2xl text-tibia-gold font-bold leading-none">{count}</span>
          <span class="text-[9px] text-tibia-muted uppercase tracking-wider">{countLabel}</span>
        </span>
      )}
    </div>
  </div>
</button>
