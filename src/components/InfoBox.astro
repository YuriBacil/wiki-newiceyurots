---
export interface Props {
  type?: 'tip' | 'warning' | 'info' | 'rule';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const config = {
  tip: { icon: '💡', border: 'border-emerald-500/30', bg: 'bg-emerald-500/8', titleColor: 'text-emerald-400' },
  warning: { icon: '⚠️', border: 'border-amber-500/30', bg: 'bg-amber-500/8', titleColor: 'text-amber-400' },
  info: { icon: 'ℹ️', border: 'border-blue-500/30', bg: 'bg-blue-500/8', titleColor: 'text-blue-400' },
  rule: { icon: '📜', border: 'border-tibia-gold/30', bg: 'bg-tibia-gold/8', titleColor: 'text-tibia-gold' }
};

const c = config[type];
---

<div class={`my-5 p-4 rounded-lg border ${c.border} ${c.bg}`}>
  <div class="flex items-start gap-3">
    <span class="text-lg flex-shrink-0">{c.icon}</span>
    <div class="flex-1">
      {title && (
        <h4 class={`font-rpg text-sm font-bold mb-1 ${c.titleColor}`}>{title}</h4>
      )}
      <div class="text-sm text-tibia-text/90 leading-relaxed">
        <slot />
      </div>
    </div>
  </div>
</div>
