---
import TierBadge from './TierBadge.astro';
import ItemSprite from './ItemSprite.astro';

interface Props {
  id: number;
  name: string;
  tier: string;
  category: string;
  attributes: string;
}

const { id, name, tier, category, attributes } = Astro.props;
---

<button
  type="button"
  data-item-id={id}
  data-tier={tier}
  class="item-card group w-full text-left bg-tibia-panel/80 border border-tibia-border-dark/30 hover:border-tibia-gold/40 transition-all cursor-pointer flex flex-col overflow-hidden relative rounded"
>
  <div class="absolute top-2 right-2 z-10">
    <TierBadge tier={tier} />
  </div>

  <div class="relative h-52 border-b border-tibia-border-dark/15 flex items-center justify-center overflow-hidden bg-gradient-to-b from-tibia-bg/40 to-transparent">
    <div class="absolute inset-0 sprite-container opacity-40"></div>
    <ItemSprite item={{ id, name }} size="2xl" className="relative z-[1] group-hover:scale-110 transition-transform duration-300" />
  </div>

  <div class="p-4 flex flex-col flex-grow">
    <span class="text-[9px] text-tibia-muted font-sans font-medium uppercase tracking-wider block text-center">
      {category}
    </span>
    <h3 class="font-rpg text-base text-tibia-gold font-bold uppercase tracking-wide text-center group-hover:text-white transition-colors leading-tight mt-1">
      {name}
    </h3>

    <div class="mt-4 pt-3 border-t border-tibia-border-dark/15">
      <p class="text-[11px] text-tibia-text text-center line-clamp-2 min-h-[2rem]">
        {attributes || 'Sem atributos registrados'}
      </p>
    </div>
  </div>
</button>
