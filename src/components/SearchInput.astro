---
interface Props {
  id: string;
  placeholder?: string;
  value?: string;
}

const { id, placeholder = 'Buscar...', value = '' } = Astro.props;
---

<div class="relative w-full">
  <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-tibia-muted/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
  </svg>
  <input
    type="text"
    id={id}
    value={value}
    placeholder={placeholder}
    class="w-full bg-tibia-bg border border-tibia-border-dark/60 rounded pl-10 pr-4 py-2.5 text-sm text-tibia-text focus:outline-none focus:border-tibia-gold transition-colors placeholder:text-tibia-muted/30"
  />
</div>
