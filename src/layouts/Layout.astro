---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Wiki oficial do IceYuriots OT - Base de dados de monstros, itens e sistemas.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body class="h-full flex flex-col">
  <header class="border-b border-tibia-border-dark bg-tibia-panel/90 backdrop-blur-md px-6 py-4 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row gap-4 justify-between items-center">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-sm flex items-center justify-center bg-tibia-bg rpg-border font-rpg text-tibia-gold text-xl font-bold group-hover:border-tibia-gold/50 transition-colors">
          IY
        </div>
        <div>
          <h1 class="font-rpg font-bold tracking-widest text-tibia-gold text-lg md:text-xl">IceYuriots</h1>
          <p class="text-xs text-tibia-muted font-medium">RETRO-MODERN BAIAK 8.60</p>
        </div>
      </a>

      <nav class="flex flex-wrap justify-center gap-1 md:gap-2">
        <a href="/" class="px-3 py-1.5 rounded text-xs font-bold uppercase tracking-wider font-rpg transition-all text-tibia-muted hover:text-tibia-gold hover:bg-tibia-bg/40">Home</a>
        <a href="/bestiario" class="px-3 py-1.5 rounded text-xs font-bold uppercase tracking-wider font-rpg transition-all text-tibia-muted hover:text-tibia-gold hover:bg-tibia-bg/40">Bestiário</a>
        <a href="/itens" class="px-3 py-1.5 rounded text-xs font-bold uppercase tracking-wider font-rpg transition-all text-tibia-muted hover:text-tibia-gold hover:bg-tibia-bg/40">Itens</a>
        <a href="/sistemas" class="px-3 py-1.5 rounded text-xs font-bold uppercase tracking-wider font-rpg transition-all text-tibia-muted hover:text-tibia-gold hover:bg-tibia-bg/40">Sistemas</a>
        <a href="/lore" class="px-3 py-1.5 rounded text-xs font-bold uppercase tracking-wider font-rpg transition-all text-tibia-muted hover:text-tibia-gold hover:bg-tibia-bg/40">Lore</a>
      </nav>
    </div>
  </header>

  <main class="flex-grow max-w-7xl w-full mx-auto p-4 md:p-8">
    <slot />
  </main>

  <footer class="border-t border-tibia-border-dark/40 bg-tibia-bg px-6 py-4 text-center text-xs text-tibia-muted mt-8">
    <p>&copy; 2026 IceYuriots OT. Todos os direitos reservados. Este site não é afiliado à CipSoft GmbH.</p>
  </footer>
</body>
</html>
